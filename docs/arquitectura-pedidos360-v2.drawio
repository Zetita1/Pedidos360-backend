        <!-- ================= notas ================= -->
        <mxCell id="novedades" value="&lt;b&gt;QU&#201; CAMBI&#211; EN LA VERSI&#211;N 2.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#183; Cl&#250;ster RabbitMQ de &lt;b&gt;dos nodos&lt;/b&gt; con docker compose&lt;br&gt;&#183; Exchanges &lt;b&gt;topic&lt;/b&gt; (hechos) y &lt;b&gt;direct&lt;/b&gt; (&#243;rdenes)&lt;br&gt;&#183; &lt;b&gt;Tres colas&lt;/b&gt; con su cola de reintento y su DLQ&lt;br&gt;&#183; &lt;b&gt;ms-notificaciones&lt;/b&gt;: consumidores por dominio&lt;br&gt;&#183; &lt;b&gt;ms-mensajeria&lt;/b&gt;: administra el broker por REST&lt;br&gt;&#183; ms-pedidos pasa a ser &lt;b&gt;productor&lt;/b&gt; de eventos&lt;br&gt;&#183; API Gateway: de 22 a &lt;b&gt;39 rutas&lt;/b&gt; con JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EC;strokeColor=#1E7A4F;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontColor=#1B2B4B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="330" height="190" as="geometry" />
        </mxCell>
        <mxCell id="notas" value="&lt;b&gt;EL TOKEN SE VALIDA EN TRES CAPAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. API Gateway&lt;/b&gt;: firma, emisor, audiencia y vigencia &#8594; &lt;b&gt;401&lt;/b&gt;&lt;br&gt;&lt;b&gt;2. Microservicio&lt;/b&gt;: lo mismo, m&#225;s tenant y rol &#8594; &lt;b&gt;403&lt;/b&gt;&lt;br&gt;&lt;b&gt;3. Llamadas internas&lt;/b&gt;: el token se reenv&#237;a y se revalida&lt;br&gt;&lt;br&gt;&lt;i&gt;El gateway decide qui&#233;n eres; el microservicio, qu&#233; puedes hacer.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#8497B0;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontColor=#1B2B4B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="862" width="330" height="150" as="geometry" />
        </mxCell>
