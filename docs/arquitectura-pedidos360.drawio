        </mxCell>

        <mxCell id="seguridad" value="&lt;b&gt;Spring Boot 3.5 &#183; Java 17 &#183; Resource Server&lt;/b&gt; en los cuatro servicios&#10;pedidos360-common-security revalida el JWT con las claves del IDaaS (JWKS) y exige el rol con @PreAuthorize &#8594; &lt;b&gt;403&lt;/b&gt; si falta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EC;strokeColor=#1E7A4F;fontColor=#1B2B4B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="825" y="765" width="605" height="55" as="geometry" />
        </mxCell>
        <mxCell id="datos" value="Persistencia: una base por microservicio &#183; perfil local H2 en memoria &#183; perfil aws PostgreSQL (JPA + Flyway)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6578;fontColor=#1B2B4B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="825" y="840" width="605" height="60" as="geometry" />
        </mxCell>

        <!-- ================= notas ================= -->
        <mxCell id="notas" value="&lt;b&gt;EL TOKEN SE VALIDA EN TRES CAPAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. API Gateway&lt;/b&gt;: firma, emisor, audiencia y vencimiento&lt;br&gt;&#160;&#160;&#160;&#8594; &lt;b&gt;401&lt;/b&gt; sin llegar al EC2&lt;br&gt;&lt;b&gt;2. Microservicio&lt;/b&gt;: lo mismo, m&#225;s tenant y rol&lt;br&gt;&#160;&#160;&#160;&#8594; &lt;b&gt;403&lt;/b&gt; si el rol no alcanza&lt;br&gt;&lt;b&gt;3. Llamadas internas&lt;/b&gt;: el token se reenv&#237;a y se revalida&lt;br&gt;&lt;br&gt;&lt;i&gt;El gateway decide qui&#233;n eres; el microservicio, qu&#233; puedes hacer.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#8497B0;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontColor=#1B2B4B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="flujoLogin" value="&lt;b&gt;FLUJO OIDC: AUTHORIZATION CODE + PKCE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;response_type=code &#183; code_challenge (S256) &#183; state &#183; nonce&lt;br&gt;El code verifier nunca sale del navegador: un c&#243;digo&lt;br&gt;interceptado no sirve sin &#233;l. Sin flujo impl&#237;cito.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;dashed=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontColor=#1B2B4B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="340" height="105" as="geometry" />
        </mxCell>
