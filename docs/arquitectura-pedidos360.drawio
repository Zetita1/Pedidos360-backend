        <!-- ================= aws ================= -->
        <mxCell id="gateway" value="&lt;b&gt;AWS API Gateway&lt;/b&gt; &#183; HTTP API&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;pedidos360-api (j9w6eomnw5)&lt;br&gt;j9w6eomnw5.execute-api.us-east-1.amazonaws.com&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&#183; 22 rutas expl&#237;citas (21 con JWT)&lt;br&gt;&#183; autorizador &lt;b&gt;entra-external-id&lt;/b&gt;: firma,&lt;br&gt;&#160;&#160;emisor, audiencia y vencimiento&lt;br&gt;&#183; CORS: Amplify + localhost:4200&lt;br&gt;&#183; etapa $default con auto-deploy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#FF9900;strokeWidth=2;fontColor=#1B2B4B;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
