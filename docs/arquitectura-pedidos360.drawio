          <mxGeometry x="1150" y="545" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pedidos" value="&lt;b&gt;ms-pedidos&lt;/b&gt; :8081&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;pedidos, estados, confirmar y anular&lt;br&gt;8 rutas publicadas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85F00;strokeWidth=2;fontColor=#1B2B4B;fontSize=12;" vertex="1" parent="1">
