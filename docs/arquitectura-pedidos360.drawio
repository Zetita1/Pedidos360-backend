        </mxCell>
        <mxCell id="err401" value="&#10007; &lt;b&gt;401&lt;/b&gt; sin token o token inv&#225;lido:&#10;responde el gateway, no llega al EC2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBEA;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="710" width="290" height="45" as="geometry" />
        </mxCell>
        <mxCell id="salud" value="&lt;b&gt;GET /health&lt;/b&gt; &#8212; &#250;nica ruta p&#250;blica,&#10;integrada al actuator del BFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EC;strokeColor=#1E7A4F;fontColor=#1E7A4F;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="768" width="290" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sg" value="&lt;b&gt;Security group&lt;/b&gt; sg-02cd650528012d232&#10;SSH 22 solo desde nuestra IP&#10;Puertos 8080-8083 alcanzables &#8594; por eso el&#10;backend revalida el token (defensa en profundidad)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85F00;fontColor=#1B2B4B;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="826" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="bff" value="&lt;b&gt;BFF&lt;/b&gt; :8080&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;GET /api/bff/perfil&lt;br&gt;GET /api/bff/tablero&lt;br&gt;vistas agregadas (2 rutas)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85F00;strokeWidth=2;fontColor=#1B2B4B;fontSize=12;" vertex="1" parent="1">
