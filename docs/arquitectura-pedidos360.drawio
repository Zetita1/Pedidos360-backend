        <mxCell id="emision" value="&lt;b&gt;Emite el access token JWT (RS256)&lt;/b&gt; &#8212; iss: https://&lt;tenant-id&gt;.ciamlogin.com/&lt;tenant-id&gt;/v2.0 &#183; aud: client ID de la API &#183; claims roles, scp y exp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E8F9;strokeColor=#0078D4;fontColor=#1B2B4B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="375" width="440" height="35" as="geometry" />
