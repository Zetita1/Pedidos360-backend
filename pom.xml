<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>cl.duoc.pedidos360</groupId>
  <artifactId>pedidos360-backend</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Pedidos360 :: Backend</name>
  <description>Backend de microservicios de Pedidos360 (BFF + dominios) protegido con JWT de Microsoft Entra ID</description>

  <modules>
    <module>pedidos360-common-security</module>
    <module>pedidos360-common-messaging</module>
    <module>ms-productos</module>
    <module>ms-clientes</module>
    <module>ms-pedidos</module>
    <module>ms-notificaciones</module>
    <module>ms-mensajeria</module>
    <module>bff-service</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>2.8.13</springdoc.version>
    <pedidos360.version>1.0.0</pedidos360.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cl.duoc.pedidos360</groupId>
        <artifactId>pedidos360-common-security</artifactId>
        <version>${pedidos360.version}</version>
      </dependency>
      <dependency>
        <groupId>cl.duoc.pedidos360</groupId>
        <artifactId>pedidos360-common-messaging</artifactId>
        <version>${pedidos360.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
